# Secrets & local environment (NEVER COMMIT)
.env
.env.*
*.env
.env.local

# Local and environment-specific app configuration. The lower-case pattern alone
# does not cover appsettings.Local.json or appsettings.Development.Local.json,
# because gitignore patterns are case-sensitive even on a case-insensitive
# filesystem — so each casing is listed. appsettings.Production.json is excluded
# because that is where a real connection string lands by convention.
appsettings.local.json
appsettings.Local.json
appsettings.*.local.json
appsettings.*.Local.json
appsettings.Production.json

# Credential material of any kind
secrets.json
*.secrets.json
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

# Log files. This service treats a VIN as personal data: a log file captured
# during a demo and left in the working tree is the easiest route for one to
# leave this machine. [Ll]og/ below covers directories, not loose files.
*.log

# Superpowers scratch workspace & internal notes
.superpowers/
docs/superpowers/RESUME.md

# Employer assessment brief PDF (keep out of public repo)
KeyloopCodingChallange.pdf

# macOS
.DS_Store

# .NET build & test outputs
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
[Bb]uild[Ll]og.*
*.[Pp]ublish.xml
*.user
*.userosscache
*.suo
*.sln.docstates
project.lock.json
project.fragment.lock.json
artifacts/

# IDEs
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp

# Internal working notes, author-local toolchain shim and the video narration
